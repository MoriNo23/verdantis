[Unit]
Description=Verdantis DBus notification daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
ExecStart=/home/extra/repositorios/verdantis/.venv/bin/python /home/extra/repositorios/verdantis/src/verdantis.py --daemon --corner top-right
Restart=on-failure
Environment=GDK_BACKEND=wayland

[Install]
WantedBy=graphical-session.target
[Unit]
Description=notify-app DBus notification daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
ExecStart=/home/fullmetal/repos/notify-app/.venv/bin/python /home/fullmetal/repos/notify-app/src/notify_app.py --daemon --corner top-right
Restart=on-failure
Environment=GDK_BACKEND=wayland

[Install]
WantedBy=graphical-session.target
